# このファイルを .env.local にコピーし、発行済みのキーだけをローカルに設定してください。
ORCAROUTER_API_KEY=
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1
ORCAROUTER_MODEL=openai/gpt-4o-mini
# モデルを変更した場合だけ、そのモデルの公開単価（USD / 100万tokens）へ更新してください。
# gpt-4o-mini は未設定でも 0.15 / 0.60 の公開単価で推定します。
ORCAROUTER_INPUT_USD_PER_MILLION=
ORCAROUTER_OUTPUT_USD_PER_MILLION=
